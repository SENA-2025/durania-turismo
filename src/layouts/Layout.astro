---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Descubre el mundo en 360 grados" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Turismo 360</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-gray-50 text-gray-900 font-sans antialiased flex flex-col min-h-screen">
		<!-- Navbar -->
		<header class="fixed w-full z-50 transition-all duration-300 bg-white/80 backdrop-blur-md shadow-sm">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center h-20">
					<!-- Logo -->
					<div class="flex-shrink-0 flex items-center gap-2 cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
						<span class="font-bold text-2xl tracking-tight text-brand-dark">Terra<span class="text-brand-primary">360</span></span>
					</div>
					
					<!-- Desktop Menu -->
					<nav class="hidden md:flex space-x-8">
						<a href="#" class="text-gray-600 hover:text-brand-primary font-medium transition-colors">Inicio</a>
						<a href="#destinos" class="text-gray-600 hover:text-brand-primary font-medium transition-colors">Destinos</a>
						<a href="#contacto" class="text-gray-600 hover:text-brand-primary font-medium transition-colors">Contacto</a>
					</nav>

                    <!-- Mobile Menu Button (Placeholder) -->
                    <div class="md:hidden flex items-center">
                        <button class="text-gray-600 hover:text-gray-900 focus:outline-none">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </button>
                    </div>
				</div>
			</div>
		</header>

		<!-- Main Content -->
		<main class="flex-grow">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="bg-brand-dark text-white pt-16 pb-8" id="contacto">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
					<div class="space-y-4">
						<div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="font-bold text-2xl tracking-tight">Terra<span class="text-brand-primary">360</span></span>
                        </div>
						<p class="text-gray-300 max-w-sm">Revolucionando la forma en que exploras el mundo. Vive experiencias inmersivas antes de empacar tus maletas.</p>
					</div>
					<div>
						<h3 class="text-lg font-semibold mb-4 text-white">Enlaces Rápidos</h3>
						<ul class="space-y-2 text-gray-300">
							<li><a href="#" class="hover:text-brand-primary transition-colors">Inicio</a></li>
							<li><a href="#destinos" class="hover:text-brand-primary transition-colors">Destinos Populares</a></li>
							<li><a href="#" class="hover:text-brand-primary transition-colors">Sobre Nosotros</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-semibold mb-4 text-white">Contacto</h3>
						<ul class="space-y-2 text-gray-300">
							<li class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                                info@terra360.com
                            </li>
							<li class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                                +1 234 567 890
                            </li>
						</ul>
					</div>
				</div>
				<div class="border-t border-gray-700 pt-8 flex flex-col md:flex-row justify-between items-center text-gray-400 text-sm">
					<p>&copy; {new Date().getFullYear()} Terra360. Todos los derechos reservados.</p>
					<div class="flex space-x-4 mt-4 md:mt-0">
						<a href="#" class="hover:text-white transition-colors">Términos</a>
						<a href="#" class="hover:text-white transition-colors">Privacidad</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
<style is:global>
	html {
		font-family: 'Inter', system-ui, sans-serif;
	}
</style>
