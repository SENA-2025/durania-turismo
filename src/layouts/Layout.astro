---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Descubre la 'Perla de Norte de Santander' de forma inmersiva" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Portal Turístico Durania</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
        
        <!-- Pannellum CSS & JS CDN -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css" />
        <script is:inline src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script>
	</head>
	<body class="bg-black h-screen w-screen overflow-hidden m-0 p-0 font-sans antialiased text-white">
        <slot />
	</body>
</html>

<style is:global>
	html, body {
		font-family: 'Inter', system-ui, sans-serif;
	}
    /* Estilos personalizados para los hotspots de Pannellum, si se desean */
    .pnlm-hotspot-base {
        z-index: 10;
    }
</style>
