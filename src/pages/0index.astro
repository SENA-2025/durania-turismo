---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Visor360 from '../components/Visor360.astro';
import { getCollection } from 'astro:content';

const propiedades = await getCollection('propiedades');
const guias = await getCollection('guias');
const informativas = await getCollection('informativas');
---

<Layout title="Inmersión 360">
    <!-- Contenedor inmersivo a pantalla completa. Layout se encarga de h-screen w-screen bg-black -->
    <main class="w-full h-full">
        <Visor360 propiedades={propiedades} guias={guias} informativas={informativas} />
    </main>
</Layout>
