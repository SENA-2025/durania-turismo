---
import Layout from '../layouts/Layout.astro';
import Visor360 from '../components/Visor360.astro';

const destinationName = "Valle Verde de las Cascadas";
const destinationDescription = "Sumérgete en un exuberante valle verde donde la naturaleza cobra vida. Escucha el relajante sonido de las cascadas cristalinas que descienden por las montañas y admira las pintorescas cabañas tradicionales con techos de pasto, un verdadero refugio de paz en medio de la naturaleza virgen.";

// Usando una imagen pública de ejemplo de Pannellum (ALMA Observatory) que representa un paisaje de altitud.
const imageUrl360 = "/images/campo_360.jpg";
---

<Layout title={destinationName}>
    <div class="pt-32 pb-16 bg-gray-50 min-h-screen">
        <!-- Encabezado del destino -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="inline-block py-1 px-3 rounded-full bg-brand-primary/10 text-brand-primary text-sm font-bold tracking-widest uppercase mb-4">
                Destino Destacado
            </span>
            <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 mb-6 tracking-tight">
                {destinationName}
            </h1>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto font-light">
                Vive la experiencia inmersiva antes de tu viaje. Haz clic y arrastra la imagen para mirar alrededor en 360 grados.
            </p>
        </div>

        <!-- Componente del Visor 360 -->
        <div class="mt-4">
            <Visor360 
                imageUrl={imageUrl360} 
                infoText={destinationDescription} 
            />
        </div>

        <!-- Botones de Acción Extras (Call to Actions) -->
        <div class="max-w-6xl mx-auto px-4 mt-8 flex flex-col sm:flex-row justify-center gap-4">
            <button class="px-8 py-4 bg-brand-primary hover:bg-brand-dark text-white text-lg font-bold rounded-2xl transition-all duration-300 shadow-[0_4px_20px_rgba(16,185,129,0.3)] hover:shadow-[0_4px_25px_rgba(6,78,59,0.4)] hover:-translate-y-1 flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                Planificar este viaje
            </button>
            <a href="/" class="px-8 py-4 bg-white hover:bg-gray-50 text-gray-800 text-lg font-bold rounded-2xl border border-gray-200 transition-all duration-300 shadow-sm flex items-center justify-center gap-2 hover:-translate-y-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Volver a destinos
            </a>
        </div>
    </div>
</Layout>
