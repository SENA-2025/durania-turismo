---
import Layout from '../layouts/Layout.astro';

const destinos = [
  {
    title: 'Auroras Boreales en Islandia',
    description: 'Sumérgete en la danza de luces celestiales desde la comodidad de un iglú de cristal.',
    image: 'https://images.unsplash.com/photo-1579033461387-adb47cedbfa5?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80',
  },
  {
    title: 'Machu Picchu Místico',
    description: 'Recorre la antigua ciudadela inca a través de una experiencia inmersiva en la cima de los Andes.',
    image: 'https://images.unsplash.com/photo-1587595431973-160d0d94add1?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80',
  },
  {
    title: 'Playas de Bora Bora',
    description: 'Relájate en aguas cristalinas y descubre la vida marina en los arrecifes de coral de la Polinesia.',
    image: 'https://images.unsplash.com/photo-1580842240505-1a2d5de41f23?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80',
  }
];
---

<Layout title="Inicio">
	<!-- Hero Section -->
	<section class="relative h-screen flex items-center justify-center overflow-hidden">
		<!-- Background Image with Overlay -->
		<div class="absolute inset-0 w-full h-full">
			<img 
                src="https://images.unsplash.com/photo-1469474968028-56623f02e42e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80" 
                alt="Naturaleza espectacular" 
                class="absolute inset-0 w-full h-full object-cover"
            />
			<div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/50 to-black/80"></div>
		</div>

		<!-- Hero Content -->
		<div class="relative z-10 text-center px-4 max-w-5xl mx-auto mt-16">
			<span class="inline-block py-1 px-3 rounded-full bg-brand-primary/20 border border-brand-primary/50 text-brand-primary backdrop-blur-sm text-sm font-semibold tracking-wider mb-6 animate-fade-in-up">
				NUEVA EXPERIENCIA VIRTUAL
			</span>
			<h1 class="text-5xl md:text-7xl font-extrabold text-white mb-6 leading-tight drop-shadow-lg">
				Descubre el mundo en <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-primary to-teal-300">360 Grados</span>
			</h1>
			<p class="text-xl md:text-2xl text-gray-200 mb-10 max-w-3xl mx-auto font-light leading-relaxed drop-shadow">
				Viaja a los rincones más impresionantes del planeta sin salir de casa. Vive aventuras inmersivas y planifica tu próximo destino real.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a href="#destinos" class="group relative px-8 py-4 bg-brand-primary text-white text-lg font-semibold rounded-full overflow-hidden shadow-[0_0_40px_rgba(16,185,129,0.4)] transition-all hover:scale-105 hover:shadow-[0_0_60px_rgba(16,185,129,0.6)] focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2 focus:ring-offset-gray-900">
					<span class="relative z-10 flex items-center gap-2">
						Explorar destinos
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
						</svg>
					</span>
				</a>
                <button class="px-8 py-4 bg-white/10 text-white text-lg font-semibold rounded-full backdrop-blur-md border border-white/20 hover:bg-white/20 transition-all focus:outline-none">
                    Ver video demo
                </button>
			</div>
		</div>

        <!-- Scroll Indicator -->
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce flex flex-col items-center text-white/70">
            <span class="text-sm font-medium mb-2 tracking-widest uppercase">Descubrir</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
        </div>
	</section>

	<!-- Destinos Destacados Section -->
	<section id="destinos" class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
                <h2 class="text-brand-primary font-bold tracking-wide uppercase text-sm mb-2">Nuestra Selección</h2>
				<h3 class="text-4xl md:text-5xl font-bold text-brand-dark mb-4">Destinos Destacados</h3>
				<p class="text-xl text-gray-600 max-w-2xl mx-auto">Lugares mágicos listos para ser explorados en nuestra plataforma inmersiva de alta calidad.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-10">
				{destinos.map((destino) => (
					<div class="group bg-white rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 border border-gray-100 flex flex-col h-full hover:-translate-y-2">
						<!-- Card Image container -->
						<div class="relative h-64 overflow-hidden">
							<img 
                                src={destino.image} 
                                alt={destino.title} 
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            />
                            <!-- Overlay gradient for title readability -->
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                            
                            <!-- 360 Badge -->
                            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full shadow-lg flex items-center gap-1.5 z-10">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-primary" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v2.197A5.973 5.973 0 0110 16v-2a2 2 0 00-2-2 2 2 0 01-2-2 2 2 0 00-1.668-1.973z" clip-rule="evenodd" />
                                </svg>
                                <span class="text-xs font-bold text-gray-900">360°</span>
                            </div>
						</div>
						
						<!-- Card Content -->
						<div class="p-8 flex flex-col flex-grow">
							<h4 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-brand-primary transition-colors">{destino.title}</h4>
							<p class="text-gray-600 mb-8 flex-grow leading-relaxed">{destino.description}</p>
							
							<button class="w-full py-4 px-6 bg-gray-50 hover:bg-brand-primary hover:text-white text-brand-dark font-semibold rounded-xl transition-all duration-300 border border-gray-200 hover:border-brand-primary flex items-center justify-center gap-2 group/btn">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
								Ver en 360
							</button>
						</div>
					</div>
				))}
			</div>
            
            <div class="mt-16 text-center">
                <a href="#" class="inline-flex items-center gap-2 text-brand-primary font-semibold hover:text-brand-dark transition-colors text-lg">
                    Ver todos los destinos
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </a>
            </div>
		</div>
	</section>
</Layout>

<style>
    /* Custom animations */
    @keyframes fade-in-up {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in-up {
        animation: fade-in-up 0.8s ease-out forwards;
    }
</style>
