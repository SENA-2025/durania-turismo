---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import App from '../components/react/App.jsx';
import '../styles/global.css';

const title = "Durania - La Tacita de Plata";
---

<Layout title={title}>
    <App client:load />
</Layout>

<style is:global>
    :root {
        --bg-main: #0a0a0a;
    }
    
    html, body {
        background-color: var(--bg-main);
        min-height: 100vh;
        width: 100%;
        overflow-y: auto;
    }
</style>
