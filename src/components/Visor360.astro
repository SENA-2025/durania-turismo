---
// src/components/Visor360.astro

// No basic props are needed as the configuration is handled internally for the tour.
const tourConfig = {
  default: {
    firstScene: "rio_peralonso",
    author: "Portal Turístico Durania",
    sceneFadeDuration: 1000
  },
  scenes: {
    rio_peralonso: {
      title: "Río Peralonso",
      type: "equirectangular",
      panorama: "/images/rio_360.jpg", // Local sample image
      autoLoad: true,
      hotSpots: [
        {
          pitch: 5,
          yaw: 20,
          type: "info",
          text: "Temperatura promedio: 23°C - 25°C"
        },
        {
          pitch: -5,
          yaw: -30,
          type: "info",
          text: "Río Peralonso: Disfruta de nuestros pozos naturales"
        },
        {
          pitch: 0,
          yaw: 120,
          type: "scene",
          text: "Ir a la Finca Cafetera",
          sceneId: "finca_cafetera"
        }
      ]
    },
    finca_cafetera: {
      title: "Finca Cafetera",
      type: "equirectangular",
      panorama: "/images/finca_360.jpg", // Local sample image
      autoLoad: true,
      hotSpots: [
        {
          pitch: 10,
          yaw: 45,
          type: "info",
          text: "Durania fue fundada el 1 de mayo de 1890 por Basilio de la Roca"
        },
        {
          pitch: 0,
          yaw: -120,
          type: "scene",
          text: "Volver al Río Peralonso",
          sceneId: "rio_peralonso"
        }
      ]
    }
  }
};
---

<div id="visor-container" class="h-screen w-full" data-config={JSON.stringify(tourConfig)}>
  <div id="panorama" class="w-full h-full"></div>
</div>

<script>
  // Robust Astro syntax: reading data attributes instead of mixing is:inline with define:vars
  document.addEventListener('astro:page-load', initPannellum);
  document.addEventListener('DOMContentLoaded', initPannellum);

  function initPannellum() {
    const container = document.getElementById('visor-container');
    if (!container) return;

    // Prevent re-initialization if already loaded
    if (container.dataset.loaded === 'true') return;
    
    const configStr = container.dataset.config;
    if (configStr && window.pannellum) {
      try {
        const config = JSON.parse(configStr);
        window.pannellum.viewer('panorama', config);
        container.dataset.loaded = 'true';
      } catch (e) {
        console.error("Error initializing Pannellum:", e);
      }
    }
  }
</script>

<style>
  /* Ensure the pannellum container occupies the full height/width of its parent */
  #panorama {
    width: 100%;
    height: 100%;
  }
</style>
